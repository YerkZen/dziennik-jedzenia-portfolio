# Track the public dotfiles explicitly and keep local credentials out of Git.
/.*
!/.gitignore
!/.nvmrc
!/.prettierrc

.env*
.dev.vars*
node_modules/
dist/
dist-worker/
coverage/
test-results/
playwright-report/
*.log
*.pem
*.key
*.p12
*.pfx
*.sqlite*
*.db
*.db-*
supabase/.temp/
supabase/.branches/
